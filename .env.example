# Copy to .env.local for local dev, or set in Vercel Project Settings → Environment Variables.

# Canonical site URL (used for metadata, sitemap, Stripe redirect URLs).
NEXT_PUBLIC_SITE_URL=https://www.precursorproperty.com

# Stripe secret key. When set, /api/order creates dynamic Checkout Sessions
# with the brief in metadata. When absent, orders fall back to the fixed
# Stripe Payment Link defined in src/lib/products.ts.
# STRIPE_SECRET_KEY=sk_live_...

# Optional: Web3Forms Pro key for server-side lead-capture backstop.
# The free-plan key lives in src/lib/products.ts and is submitted from the
# browser (Web3Forms free plan requires client-origin calls).
# WEB3FORMS_ACCESS_KEY=

# Optional: Google Search Console verification token. When set, it renders as
# the google-site-verification meta tag. Get it from Search Console using the
# "HTML tag" verification method (paste only the content value, not the tag).
# GOOGLE_SITE_VERIFICATION=

# Optional: Unsplash API access key (free at unsplash.com/developers).
# When set, the homepage hero montage pulls fresh Melbourne aerials from the
# Unsplash API once a day. When absent, the committed images in /public/hero
# are used. Server-side only; never exposed to the browser.
# UNSPLASH_ACCESS_KEY=
